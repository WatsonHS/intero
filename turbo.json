{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "INTERO_API_HOST",
        "INTERO_API_PORT",
        "INTERO_API_URL",
        "INTERO_AUTH_SECRET",
        "INTERO_CENTRIFUGO_API_KEY",
        "INTERO_CENTRIFUGO_API_URL",
        "INTERO_CONNECTION_FILE",
        "INTERO_DATABASE_URL",
        "INTERO_DATA_DIR",
        "INTERO_GITHUB_CLIENT_ID",
        "INTERO_GITHUB_CLIENT_SECRET",
        "INTERO_LOCAL_REPRESENTATIVE_ID",
        "INTERO_LOCAL_REPRESENTATIVE_NAME",
        "INTERO_LOCAL_REP_MODE",
        "INTERO_LOCAL_TOKEN",
        "INTERO_LOG_LEVEL",
        "INTERO_MAGIC_LINK_WEBHOOK",
        "INTERO_MODEL_EGRESS",
        "INTERO_ORGANIZATION_ID",
        "INTERO_ORGANIZATION_NAME",
        "INTERO_PASSKEY_RP_ID",
        "INTERO_PRINCIPAL_ID",
        "INTERO_PRINCIPAL_NAME",
        "INTERO_PUBLIC_REPRESENTATIVE_ID",
        "INTERO_PUBLIC_URL",
        "INTERO_S3_ACCESS_KEY_ID",
        "INTERO_S3_BUCKET",
        "INTERO_S3_ENDPOINT",
        "INTERO_S3_REGION",
        "INTERO_S3_SECRET_ACCESS_KEY",
        "INTERO_S3_SERVER_ENCRYPTION",
        "INTERO_SEED_DEMO",
        "INTERO_SOCKET",
        "INTERO_SPICEDB_ENDPOINT",
        "INTERO_SPICEDB_INSECURE",
        "INTERO_SPICEDB_TOKEN",
        "INTERO_WORKER_CONCURRENCY",
        "INTERO_WORKER_DATABASE_URL",
        "VITE_INTERO_API_URL"
      ]
    },
    "generate": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
