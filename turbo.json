{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "INTERO_API_HOST",
        "INTERO_API_PORT",
        "INTERO_API_URL",
        "INTERO_AUTH_SECRET",
        "INTERO_AUTH_TRUSTED_ORIGINS",
        "INTERO_ALLOW_DEVELOPMENT_IDENTITY",
        "INTERO_CENTRIFUGO_API_KEY",
        "INTERO_CENTRIFUGO_API_URL",
        "INTERO_DATABASE_URL",
        "INTERO_LOG_LEVEL",
        "INTERO_MODEL_EGRESS",
        "INTERO_ORGANIZATION_ID",
        "INTERO_ORGANIZATION_NAME",
        "INTERO_PASSKEY_RP_ID",
        "INTERO_PILOT_PERSISTENCE",
        "INTERO_PRINCIPAL_ID",
        "INTERO_PRINCIPAL_NAME",
        "INTERO_PUBLIC_STAND_IN_ID",
        "INTERO_PUBLIC_URL",
        "INTERO_S3_ACCESS_KEY_ID",
        "INTERO_S3_BUCKET",
        "INTERO_S3_ENDPOINT",
        "INTERO_S3_REGION",
        "INTERO_S3_SECRET_ACCESS_KEY",
        "INTERO_S3_SERVER_ENCRYPTION",
        "INTERO_SEED_DEMO",
        "INTERO_SPICEDB_ENDPOINT",
        "INTERO_SPICEDB_INSECURE",
        "INTERO_SPICEDB_TOKEN",
        "INTERO_WORKER_CONCURRENCY",
        "INTERO_WORKER_DATABASE_URL",
        "VITE_INTERO_API_URL"
      ]
    },
    "dev:pilot": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "INTERO_API_HOST",
        "INTERO_API_PORT",
        "INTERO_DATABASE_URL",
        "INTERO_ORGANIZATION_ID",
        "INTERO_ORGANIZATION_NAME",
        "INTERO_PILOT_PERSISTENCE",
        "INTERO_PROVIDER_ENCRYPTION_KEY",
        "VITE_INTERO_API_URL"
      ]
    },
    "generate": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
