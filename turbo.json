{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "INTERO_API_HOST",
        "INTERO_API_PORT",
        "INTERO_API_URL",
        "INTERO_AUTH_SECRET",
        "INTERO_AUTH_TRUSTED_ORIGINS",
        "INTERO_ALLOW_DEVELOPMENT_IDENTITY",
        "INTERO_RUNTIME_MODE",
        "INTERO_CENTRIFUGO_API_KEY",
        "INTERO_CENTRIFUGO_API_URL",
        "INTERO_CENTRIFUGO_PUBLIC_URL",
        "INTERO_CENTRIFUGO_TOKEN_SECRET",
        "DATABASE_URL",
        "INTERO_DATABASE_URL",
        "INTERO_LOG_LEVEL",
        "INTERO_MODEL_EGRESS",
        "INTERO_OBJECT_STORAGE",
        "INTERO_OBJECT_STORAGE_ABORT_MULTIPART_DAYS",
        "INTERO_OBJECT_STORAGE_ACCESS_KEY_ID",
        "INTERO_OBJECT_STORAGE_BUCKET",
        "INTERO_OBJECT_STORAGE_ENCRYPTION",
        "INTERO_OBJECT_STORAGE_ENDPOINT",
        "INTERO_OBJECT_STORAGE_KMS_KEY_ID",
        "INTERO_OBJECT_STORAGE_MAX_BYTES",
        "INTERO_OBJECT_STORAGE_PENDING_TTL_SECONDS",
        "INTERO_OBJECT_STORAGE_QUARANTINE_DAYS",
        "INTERO_OBJECT_STORAGE_REGION",
        "INTERO_OBJECT_STORAGE_SECRET_ACCESS_KEY",
        "INTERO_OBJECT_STORAGE_TENANT_PREFIX",
        "INTERO_ORGANIZATION_ID",
        "INTERO_ORGANIZATION_NAME",
        "INTERO_PASSKEY_RP_ID",
        "INTERO_PILOT_PERSISTENCE",
        "INTERO_PRINCIPAL_ID",
        "INTERO_PRINCIPAL_NAME",
        "INTERO_PUBLIC_STAND_IN_ID",
        "INTERO_PUBLIC_URL",
        "INTERO_SEED_DEMO",
        "INTERO_SPICEDB_ENDPOINT",
        "INTERO_SPICEDB_INSECURE",
        "INTERO_SPICEDB_TOKEN",
        "INTERO_WORKER_CONCURRENCY",
        "INTERO_WORKER_DATABASE_URL",
        "VITE_INTERO_API_URL"
      ]
    },
    "dev:pilot": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "INTERO_API_HOST",
        "INTERO_API_PORT",
        "INTERO_AUTH_DEVELOPMENT_LINKS",
        "INTERO_AUTH_SECRET",
        "INTERO_AUTH_TRUSTED_ORIGINS",
        "INTERO_ALLOW_DEVELOPMENT_IDENTITY",
        "INTERO_CENTRIFUGO_API_KEY",
        "INTERO_CENTRIFUGO_API_URL",
        "INTERO_CENTRIFUGO_PUBLIC_URL",
        "INTERO_CENTRIFUGO_TOKEN_SECRET",
        "INTERO_DATABASE_URL",
        "INTERO_OBJECT_STORAGE",
        "INTERO_OBJECT_STORAGE_ABORT_MULTIPART_DAYS",
        "INTERO_OBJECT_STORAGE_ACCESS_KEY_ID",
        "INTERO_OBJECT_STORAGE_BUCKET",
        "INTERO_OBJECT_STORAGE_ENCRYPTION",
        "INTERO_OBJECT_STORAGE_ENDPOINT",
        "INTERO_OBJECT_STORAGE_KMS_KEY_ID",
        "INTERO_OBJECT_STORAGE_MAX_BYTES",
        "INTERO_OBJECT_STORAGE_PENDING_TTL_SECONDS",
        "INTERO_OBJECT_STORAGE_QUARANTINE_DAYS",
        "INTERO_OBJECT_STORAGE_REGION",
        "INTERO_OBJECT_STORAGE_SECRET_ACCESS_KEY",
        "INTERO_OBJECT_STORAGE_TENANT_PREFIX",
        "INTERO_ORGANIZATION_ID",
        "INTERO_ORGANIZATION_NAME",
        "INTERO_PASSKEY_RP_ID",
        "INTERO_PILOT_PERSISTENCE",
        "INTERO_PILOT_AUTHORIZATION",
        "INTERO_PILOT_STAND_IN_JOBS",
        "INTERO_PROVIDER_ENCRYPTION_KEY",
        "INTERO_PUBLIC_URL",
        "INTERO_RUNTIME_MODE",
        "INTERO_SPICEDB_ENDPOINT",
        "INTERO_SPICEDB_INSECURE",
        "INTERO_SPICEDB_TOKEN",
        "INTERO_WORKER_CONCURRENCY",
        "INTERO_WORKER_DATABASE_URL",
        "INTERO_WORKER_METRICS_HOST",
        "INTERO_WORKER_METRICS_PORT",
        "VITE_INTERO_API_URL"
      ]
    },
    "generate": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
