# For a LAN pilot, set this to an HTTPS origin. Browsers only expose the
# microphone and camera to HTTPS pages or localhost.
# INTERO_PUBLIC_URL=https://intero-host.local
INTERO_PUBLIC_URL=http://localhost:4311
INTERO_DATABASE_URL=postgres://intero_app:intero_app@localhost:5432/intero
INTERO_PROVIDER_ENCRYPTION_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgres://intero:intero@localhost:5432/intero
DATABASE_APP_URL=postgres://intero_app:intero_app@localhost:5432/intero
INTERO_WORKER_DATABASE_URL=postgres://intero_worker:intero_worker@localhost:5432/intero
INTERO_SPICEDB_ENDPOINT=localhost:50051
INTERO_SPICEDB_TOKEN=intero-development
# LiveKit handles RTC signaling, SFU media, reconnection, and ICE/TURN. The
# development server uses its built-in devkey/secret credentials.
# Open the configured ICE/TCP and ICE/UDP ports on the host firewall.
# INTERO_LIVEKIT_TCP_PORT=7881
# INTERO_LIVEKIT_UDP_PORT=7882
# MinIO is required. These development values match compose.yaml.
INTERO_OBJECT_STORAGE_ENDPOINT=http://localhost:29000
INTERO_OBJECT_STORAGE_ACCESS_KEY_ID=intero
INTERO_OBJECT_STORAGE_SECRET_ACCESS_KEY=intero-development
INTERO_OBJECT_STORAGE_BUCKET=intero-objects
# Product mode is selected by NODE_ENV=production and requires persistent
# Better Auth sessions. Development identity is automatic without auth.
# Authentication is enabled when this value is configured.
# INTERO_AUTH_SECRET=replace-with-at-least-32-random-characters
