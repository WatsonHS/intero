INTERO_API_HOST=0.0.0.0
INTERO_API_PORT=4310
INTERO_CADDY_PORT=4311
# Keep this equal to the port in INTERO_PUBLIC_URL. Use 443 for a domain
# without an explicit port.
INTERO_CADDY_LISTEN_PORT=4311
INTERO_PUBLIC_URL=http://localhost:4311
INTERO_DATABASE_URL=postgres://intero_app:intero_app@localhost:5432/intero
INTERO_PILOT_PERSISTENCE=postgres
INTERO_PROVIDER_ENCRYPTION_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgres://intero:intero@localhost:5432/intero
DATABASE_APP_URL=postgres://intero_app:intero_app@localhost:5432/intero
INTERO_WORKER_DATABASE_URL=postgres://intero_worker:intero_worker@localhost:5432/intero
INTERO_PILOT_REPRESENTATIVE_JOBS=transactional-outbox
INTERO_PILOT_AUTHORIZATION=spicedb
INTERO_SPICEDB_ENDPOINT=localhost:50051
INTERO_SPICEDB_TOKEN=intero-development
INTERO_SPICEDB_INSECURE=true
INTERO_PILOT_REALTIME=centrifugo
INTERO_CENTRIFUGO_API_URL=http://localhost:8000
# INTERO_CENTRIFUGO_API_KEY=
# Object storage is an internal adapter only and remains disabled by default.
INTERO_OBJECT_STORAGE=disabled
# INTERO_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# INTERO_OBJECT_STORAGE_REGION=us-east-1
# INTERO_OBJECT_STORAGE_ACCESS_KEY_ID=intero
# INTERO_OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-server-only-secret
# INTERO_OBJECT_STORAGE_BUCKET=intero-objects
# INTERO_OBJECT_STORAGE_TENANT_PREFIX=tenants
# INTERO_OBJECT_STORAGE_MAX_BYTES=26214400
# INTERO_OBJECT_STORAGE_PENDING_TTL_SECONDS=3600
# INTERO_OBJECT_STORAGE_QUARANTINE_DAYS=30
# INTERO_OBJECT_STORAGE_ABORT_MULTIPART_DAYS=1
# INTERO_OBJECT_STORAGE_ENCRYPTION=AES256
# INTERO_OBJECT_STORAGE_KMS_KEY_ID=
INTERO_METRICS_ENABLED=true
INTERO_WORKER_METRICS_HOST=127.0.0.1
INTERO_WORKER_METRICS_PORT=9464
INTERO_LOG_LEVEL=info
INTERO_PRINCIPAL_ID=019b5ac0-7600-7000-8000-000000000002
INTERO_PRINCIPAL_NAME=Intero User
INTERO_STAND_IN_ID=019b5ac0-7600-7000-8000-000000000003
INTERO_STAND_IN_NAME=Intero Stand-in
# Demo fixtures are opt-in. Leave unset for empty or real pipeline state.
# INTERO_SEED_DEMO=true
# Runtime auth boundary: product requires persistent Better Auth sessions;
# development may opt into the explicit identity simulator below.
# INTERO_RUNTIME_MODE=product
# Optional only for headless development/CI; production defaults to the OS credential store.
# INTERO_DATABASE_KEY=<base64-encoded 32-byte key>
# Authentication is disabled unless both values are configured.
# INTERO_AUTH_SECRET=replace-with-at-least-32-random-characters
# VITE_INTERO_API_URL=https://intero.example.com
# INTERO_MAGIC_LINK_WEBHOOK=http://localhost:4320/magic-link
# Local browser tests may use this instead of a webhook. Never enable in production.
# INTERO_AUTH_DEVELOPMENT_LINKS=true
# Local aliases on ports 4310, 4311, and 5173 are trusted automatically.
# Set this explicitly for a non-local deployment.
# INTERO_AUTH_TRUSTED_ORIGINS=https://intero.example.com
# Development/test only. Rejected when INTERO_RUNTIME_MODE=product.
# INTERO_ALLOW_DEVELOPMENT_IDENTITY=true
INTERO_PASSKEY_RP_ID=localhost
# INTERO_GITHUB_CLIENT_ID=
# INTERO_GITHUB_CLIENT_SECRET=
