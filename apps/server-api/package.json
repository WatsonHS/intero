{
  "name": "@intero/server-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "generate": "tsx src/generate-openapi.ts",
    "migrate": "tsx src/database/migrate.ts",
    "migrate:spicedb": "tsx src/spicedb-migrate.ts",
    "test:database": "vitest run --root ../.. apps/server-api/src/database/rls.integration.test.ts apps/server-api/src/postgres-store.integration.test.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@authzed/authzed-node": "^1.6.1",
    "@better-auth/passkey": "^1.3.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/swagger": "^9.5.0",
    "@intero/api-contracts": "workspace:*",
    "@intero/attachments": "workspace:*",
    "@intero/config": "workspace:*",
    "@intero/domain": "workspace:*",
    "@intero/representative-core": "workspace:*",
    "better-auth": "^1.3.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.4.0",
    "fastify-type-provider-zod": "^6.0.0",
    "pg": "^8.22.0",
    "pino": "^9.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "prettier": "^3.6.0"
  }
}
