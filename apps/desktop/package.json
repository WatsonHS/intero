{
  "name": "@intero/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "electron-vite build",
    "package": "pnpm --filter @intero/mcp-stdio build && pnpm build && electron-builder --dir",
    "dev": "electron-vite dev",
    "test": "vitest run --root ../.. apps/desktop/src/main"
  },
  "build": {
    "appId": "com.intero.desktop",
    "productName": "Intero",
    "asar": true,
    "mac": {
      "extendInfo": {
        "NSCameraUsageDescription": "Intero uses the camera when you join a video call.",
        "NSMicrophoneUsageDescription": "Intero uses the microphone when you join a voice or video call."
      }
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../mcp-stdio/dist/index.js",
        "to": "intero-mcp-runtime/index.js"
      },
      {
        "from": "resources/intero-mcp",
        "to": "intero-mcp"
      },
      {
        "from": "resources/intero-mcp.cmd",
        "to": "intero-mcp.cmd"
      }
    ]
  },
  "dependencies": {
    "@intero/integrations": "workspace:*"
  },
  "devDependencies": {
    "@intero/web": "workspace:*",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0"
  },
  "main": "./out/main/index.js"
}
