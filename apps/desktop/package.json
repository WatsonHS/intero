{
  "name": "@intero/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "electron-vite build",
    "package": "pnpm --filter @intero/mcp-stdio build && pnpm build && electron-builder --dir",
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.intero.desktop",
    "productName": "Intero",
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../mcp-stdio/dist/index.js",
        "to": "intero-mcp-runtime/index.js"
      },
      {
        "from": "resources/intero-mcp",
        "to": "intero-mcp"
      },
      {
        "from": "resources/intero-mcp.cmd",
        "to": "intero-mcp.cmd"
      }
    ]
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/view": "^6.43.6",
    "@intero/domain": "workspace:*",
    "@intero/integrations": "workspace:*",
    "@intero/local-ipc": "workspace:*",
    "@intero/ui": "workspace:*",
    "@phosphor-icons/react": "^2.1.0",
    "@tanstack/react-query": "^5.81.0",
    "@tanstack/react-router": "^1.125.0",
    "@uiw/react-codemirror": "^4.25.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0"
  },
  "main": "./out/main/index.js"
}
