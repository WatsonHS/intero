# Canonical LAN origin. Switch this value, Caddy ports, trusted origins, and
# Agent configuration version together when moving to an HTTPS domain.
INTERO_PUBLIC_URL=http://172.21.1.123:4311
INTERO_CADDY_PORT=4311
INTERO_CADDY_LISTEN_PORT=4311

# This Mac currently stores Intero data in this Docker volume. Keep the value
# when cutting over from dev:pilot so the production stack opens the same data.
INTERO_POSTGRES_VOLUME=intero-codex_intero-postgres
INTERO_POSTGRES_HOST_PORT=15432
INTERO_CADDY_DATA_VOLUME=intero-production-caddy-data
INTERO_CADDY_CONFIG_VOLUME=intero-production-caddy-config
INTERO_MINIO_VOLUME=intero-production-minio

# On the first cutover from the existing local database, bootstrap is the old
# `intero` role password. Provisioning rotates it to ADMIN_PASSWORD and future
# deploys automatically fall back to the rotated value.
INTERO_POSTGRES_BOOTSTRAP_PASSWORD=replace-with-current-admin-password
INTERO_POSTGRES_ADMIN_PASSWORD=replace-with-32-random-hex-characters
INTERO_POSTGRES_APP_PASSWORD=replace-with-32-random-hex-characters
INTERO_POSTGRES_WORKER_PASSWORD=replace-with-32-random-hex-characters
INTERO_POSTGRES_SPICEDB_PASSWORD=replace-with-32-random-hex-characters

# Preserve the current value when reusing an existing database: changing it
# makes already-encrypted model-provider credentials unreadable.
INTERO_PROVIDER_ENCRYPTION_KEY=replace-with-the-current-provider-key
INTERO_AUTH_SECRET=replace-with-at-least-32-random-characters
INTERO_SPICEDB_TOKEN=replace-with-a-distinct-random-token
INTERO_CENTRIFUGO_API_KEY=replace-with-a-distinct-random-api-key
INTERO_CENTRIFUGO_TOKEN_SECRET=replace-with-at-least-32-random-characters
INTERO_MINIO_ACCESS_KEY=intero-production
INTERO_MINIO_SECRET_KEY=replace-with-at-least-32-random-characters
# Generate with: openssl rand -base64 32
INTERO_MINIO_KMS_KEY=replace-with-a-base64-encoded-32-byte-key
INTERO_OBJECT_STORAGE_BUCKET=intero-objects

INTERO_WORKER_CONCURRENCY=8
INTERO_LOG_LEVEL=info
