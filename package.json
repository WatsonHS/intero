{
  "name": "intero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.12",
      "@modelcontextprotocol/sdk>@hono/node-server": "^2.0.12"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@intero/web --filter=@intero/server-api --filter=@intero/server-worker",
    "dev:desktop": "turbo run dev --filter=@intero/desktop --filter=@intero/server-api --filter=@intero/server-worker",
    "dev:pilot": "bash scripts/dev-pilot.sh",
    "dev:proxy": "docker compose -f compose.proxy.yaml up -d",
    "dev:proxy:down": "docker compose -f compose.proxy.yaml down",
    "generate": "turbo run generate",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm test:ts",
    "test:ts": "vitest run",
    "test:watch": "vitest",
    "test:e2e:phase6": "playwright test tests/e2e/phase6.spec.ts",
    "test:e2e:phase7": "playwright test tests/e2e/phase7.spec.ts",
    "test:e2e:collaboration": "playwright test tests/e2e/collaboration-chain.spec.ts",
    "test:e2e:agent-connection": "playwright test tests/e2e/coding-agent-connection.spec.ts",
    "check": "pnpm lint && pnpm test && pnpm build",
    "format:check": "prettier --check .",
    "demo:seed": "pnpm --filter @intero/server-api demo:seed",
    "demo:reset": "pnpm --filter @intero/server-api demo:reset",
    "demo:reset-and-seed": "pnpm --filter @intero/server-api demo:reset-and-seed",
    "dev:demo": "scripts/dev-demo.sh",
    "backup:postgres": "scripts/ops/backup-postgres.sh",
    "restore:postgres": "scripts/ops/restore-postgres.sh",
    "production:compose": "scripts/ops/production-compose.sh",
    "production:generate-spicedb-tls": "scripts/ops/generate-spicedb-tls.sh",
    "production:deploy": "scripts/ops/deploy-production.sh",
    "production:rollback": "scripts/ops/rollback-production.sh",
    "production:backup": "scripts/ops/backup-production.sh",
    "production:install-launch-agent": "scripts/ops/install-production-launch-agent.sh"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@playwright/test": "1.60.0",
    "drizzle-kit": "^0.31.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
