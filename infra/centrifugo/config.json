{
  "client": {
    "insecure": true,
    "allowed_origins": ["http://localhost:5173"]
  },
  "admin": {
    "enabled": true,
    "insecure": true
  },
  "http_api": {
    "insecure": true
  },
  "channel": {
    "namespaces": [
      {
        "name": "intero",
