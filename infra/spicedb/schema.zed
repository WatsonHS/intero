definition principal {}

definition organization {
  relation member: principal
  relation admin: principal
  permission view = member + admin
  permission manage = admin
}

definition team {
  relation organization: organization
  relation member: principal
  relation leader: principal
  relation manager: principal
  permission participate = member + leader
  permission manage_members = leader + manager + organization->manage
  permission view = member + leader + organization->manage
}

definition project {
  relation organization: organization
  relation participating_team: team
  relation member: principal
  relation manager: principal
  relation owner: principal
  permission participate = owner + member + participating_team->participate
  permission manage_collaboration = owner + manager
  permission view = member + manager + organization->view
  permission manage = manager + organization->manage
}

definition thread {
  relation project: project
  relation participant: principal
  relation stand_in: principal
  permission view = participant + stand_in + project->manage
  permission post = participant + stand_in
  permission manage_access = participant
}

definition spec {
  relation project: project
  relation author: principal
  relation reviewer: principal
  permission view = author + reviewer + project->view
  permission edit = author + project->manage
  permission review = reviewer + project->manage
}

definition artifact {
  relation project: project
  relation owner: principal
  relation reader: principal
  permission view = owner + reader + project->manage
}
